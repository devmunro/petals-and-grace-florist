---
const title = "Petals & Grace";
const subtitle = "Exquisite floral artistry for life's most precious moments";
const bgImage = "../assets/header-bg.jpg"; 
---

<header
    class="flex flex-col items-center justify-center min-h-screen bg-cover bg-center"
    style={`background-image: url('/header-bg.jpg')`}
>
    <div class="bg-[#A7A5A6]/85 w-full p-8 rounded-lg flex flex-col space-y-8">
        <h1 class="text-6xl font-(family-name:--font-cursive) font-bold text-white mb-4 text-center">{title}</h1>
        <p class="text-xl text-white text-center">{subtitle}</p>
        <button class="text-md text-white bg-red-400 hover:bg-red-500 p-4 rounded cursor-pointer text-center">Explore Our Collection</button>
    </div>
</header>