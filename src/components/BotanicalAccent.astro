		<path class="botanical-accent__leaf" d="M67 228C50 224 37 209 35 190C54 191 68 205 67 228Z" />
		<path class="botanical-accent__leaf" d="M73 163C91 143 109 131 128 126C125 148 106 163 73 163Z" />
		<path class="botanical-accent__leaf" d="M104 107C89 104 77 91 74 72C91 73 104 85 104 107Z" />
		<path class="botanical-accent__stem" d="M22 514C27 488 32 470 37 460C42 441 51 417 57 411C66 393 73 360 79 342C82 323 83 302 81 290C78 268 69 246 67 228C65 204 69 180 73 163C77 139 91 116 104 107C117 93 127 57 126 18" />
